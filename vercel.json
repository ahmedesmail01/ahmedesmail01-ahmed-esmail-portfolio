{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/landing-pages/inner-green-3d.html",
      "destination": "/landing-pages/inner-green-3d/",
      "permanent": true
    },
    {
      "source": "/landing-pages/sublevel-studio.html",
      "destination": "/landing-pages/sublevel-studio/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/landing-pages/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/responsive/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/landing-pages/inner-green-assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
